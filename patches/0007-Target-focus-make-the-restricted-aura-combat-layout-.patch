-		maxFrameCount = 40,
-		layout = {
-			elementWidth = size,
-			elementHeight = size,
-			elementSpacing = 1,
-			lineSpacing = 1,
-			layoutIndex = 1,
-		},
-		initializeFrame = function(button)
-			XPerl_AuraContainer_InitButtonCommon(button, size, showSwipe)
-		end,
-	})
-	-- Z-Perl Forever: optional hook XPerl_BuffContainerFilter(frame, container, groupKey, filter),
